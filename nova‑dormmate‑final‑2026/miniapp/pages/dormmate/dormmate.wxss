.card {
  margin: 24rpx;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(43, 52, 64, 0.12);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a8494;
  text-align: center;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  border: 2rpx solid #cfd8e3;
  border-radius: 12rpx;
}

.error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #c0392b;
  background: #fdecea;
  border-radius: 12rpx;
}

.btn {
  width: 100%;
  margin: 0;
  padding: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a90d9;
  border-radius: 12rpx;
}

.btn::after {
  border: none;
}

.result {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  text-align: center;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.result-advice {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 四种环境状态配色（与 Web 一致） */
.status-cold {
  background: #e8f2fd;
  border: 2rpx solid #a8c8ec;
  color: #1d5fa8;
}

.status-hot {
  background: #fdeee8;
  border: 2rpx solid #ecb8a3;
  color: #b5502a;
}

.status-humid {
  background: #e5f6f6;
  border: 2rpx solid #a3d6d6;
  color: #1a8a8a;
}

.status-normal {
  background: #eaf5e9;
  border: 2rpx solid #b3dcb0;
  color: #3c7a34;
}
