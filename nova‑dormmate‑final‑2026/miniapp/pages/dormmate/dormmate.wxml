<view class="card">
  <view class="title">宿舍环境判断</view>
  <view class="subtitle">输入温度与湿度，一键判断环境状态</view>

  <view class="field">
    <text class="label">温度（℃）</text>
    <input class="input" type="digit" placeholder="0 ~ 50" value="{{temperature}}" bindinput="onTempInput" />
  </view>
  <view class="field">
    <text class="label">湿度（%）</text>
    <input class="input" type="digit" placeholder="0 ~ 100" value="{{humidity}}" bindinput="onHumInput" />
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="btn" bindtap="onAnalyze">分析环境</button>

  <view class="result {{resultClass}}" wx:if="{{status}}">
    <view class="result-title">环境状态：{{status}}</view>
    <view class="result-advice">{{advice}}</view>
  </view>
</view>
